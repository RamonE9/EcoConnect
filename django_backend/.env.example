# EcoConnect backend configuration
# Copy this file to .env (same folder) and fill in the values.
# Never commit the real .env file.

# ── Required ─────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ecoconnect

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Required whenever DEBUG=False (the server refuses to start without it).
SECRET_KEY=

# True only on your own computer. Production must use False.
DEBUG=True

# ── Hosts & origins (production) ─────────────────────────
# Comma-separated hostnames the backend answers to
ALLOWED_HOSTS=
# Full origins allowed to submit forms, e.g. https://ecoconnect.netlify.app
CSRF_TRUSTED_ORIGINS=
# Browser origins allowed to call the API directly (not needed behind the Netlify proxy)
CORS_ALLOWED_ORIGINS=
# Set to False only if your host already forces HTTPS and redirects loop
SECURE_SSL_REDIRECT=True

# ── Email (sign-up and password-reset codes) ─────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
# Gmail: use an App Password, not your normal password
MAIL_PASSWORD=

# ── Optional integrations ────────────────────────────────
# Google AI Studio key for the chat assistant (server-side only)
GEMINI_API_KEY=
# Optional: models to try in order (comma-separated)
GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest
SUPABASE_URL=
SUPABASE_KEY=
# Public bucket for profile photos
SUPABASE_STORAGE_BUCKET=photos
# PRIVATE bucket for barangay ID photos (viewed only through expiring links)
SUPABASE_ID_BUCKET=barangay-ids
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
